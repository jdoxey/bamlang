{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/lang-budget/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/lang-budget/budget-gate.sh",
            "timeout": 700000
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(docs/CHARTER.md)",
      "Edit(docs/RULINGS.md)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(~/.claude/lang-budget/**)",
      "Edit(.github/workflows/charter-guard.yml)",
      "Edit(ci/adr-check.sh)",
      "Edit(ci/tour-check.sh)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
