fn parsePositive(text String) Result of Int, Error {
    let n = text.toInt()?
    if n <= 0 { return Err(Error("not positive: {n}")) }
    Ok(n)
}

fn double(text String) Result of Int, Error {
    let n = parsePositive(text)?
    Ok(n * 2)
}

fn main() {
    print(double("21"))
    print(double("-4"))
    print(double("x"))
    print(["a"].get(3) or "none")
    print(["a"].get(0) or "none")
}
