fn main() {
    var sum = 0
    for i in 1..=5 {
        if i % 2 == 0 { continue }
        sum = sum + i
    }
    print(sum)
    var n = 0
    while n < 3 { n = n + 1 }
    print(n)
    let label = if sum > 5 { "big" } else { "small" }
    print(label)
    loop {
        n = n + 1
        if n >= 6 { break }
    }
    print(n)
}
