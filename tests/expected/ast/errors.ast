  (fn replace_file fails
    (param dir
      (t Path))
    (param name
      (t Str))
    (param content
      (t Str))
    (param fail_at
      (t Int))
    (block
      (let lock_path
        (interp
          (part
            (name dir))
          (s "/")
          (part
            (name name))
          (s ".lock")))
      (let tmp
        (interp
          (part
            (name dir))
          (s "/")
          (part
            (name name))
          (s ".tmp")))
      (let dst
        (interp
          (part
            (name dir))
          (s "/")
          (part
            (name name))))
      (let txn
        (mcall new
          (name Txn)
          (named undo
            (lambda
              (block
                (call
                  (name remove)
                  (named path
                    (name tmp))))))))
      (let held
        (try-context
          (mcall create
            (name Lock)
            (named path
              (name lock_path)))
          (str "step 1: create lock")))
      (mcall on_undo
        (name txn)
        (named action
          (lambda
            (mcall abandon
              (name held)))))
      (try-context
        (call
          (name inject)
          (named fail_at
            (name fail_at))
          (named step
            (int 1)))
        (str "step 1: create lock"))
      (let f
        (try-context
          (mcall create
            (name File)
            (named path
              (name tmp)))
          (str "step 2: write temp")))
      (try-context
        (mcall write
          (name f)
          (named text
            (name content)))
        (str "step 2: write temp"))
      (try-context
        (mcall close
          (name f))
        (str "step 2: write temp"))
      (try-context
        (call
          (name inject)
          (named fail_at
            (name fail_at))
          (named step
            (int 2)))
        (str "step 2: write temp"))
      (try-context
        (call
          (name inject)
          (named fail_at
            (name fail_at))
          (named step
            (int 3)))
        (str "step 3: rename temp"))
      (try-context
        (call
          (name rename)
          (named from
            (name tmp))
          (named to
            (name dst)))
        (str "step 3: rename temp"))
      (try-context
        (call
          (name inject)
          (named fail_at
            (name fail_at))
          (named step
            (int 4)))
        (str "step 4: remove lock"))
      (try-context
        (mcall close
          (name held))
        (str "step 4: remove lock"))
      (mcall commit
        (name txn))))
  (fn part2 fails
    (block
