      (let labels
        (list
          (str "no failure")
          (str "fail at step 1")
          (str "fail at step 2")
          (str "fail at step 3")
          (str "fail at step 4")))
      (for
        (pbind run)
        (bin ..
          (int 0)
          (int 5))
        (block
