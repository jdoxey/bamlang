(file
  (const BAD_TEXT
    (bin +
      (bin +
        (bin +
          (bin +
            (str "[server]\n")
            (str "port = 8080\n"))
          (str "port = 9090\n"))
        (str "=orphan\n"))
      (str "name\n")))
  (const GOOD_TEXT
    (str "# demo\n[server]\nport = 8080\n"))
  (const TEXTS
    (list
      (str "a=1\nb=2\n")
      (str "a=1\noops\n")
      (str "a=1\n")
      (str "a=1\nb=2\nc=3\n")))
  (type Entry
    (field section
      (t Str))
    (field key
      (t Str))
    (field value
      (t Str)))
  (type Config
    (field entries
      (t List
        (t Entry))
      (default
        (list)))
    (fn get
      (recv self)
      (param section
        (t Str))
      (param key
        (t Str))
      (ret
        (t Optional
          (t Str)))
      (block
        (for
          (pbind e)
          (field entries
            (name self))
          (block
            (if
              (bin and
                (bin ==
                  (field section
                    (name e))
                  (name section))
                (bin ==
                  (field key
                    (name e))
                  (name key)))
              (block
                (return
                  (call
                    (name some)
                    (named value
                      (field value
                        (name e)))))))))
        (return
          (none))))
    (fn len
      (recv self)
      (ret
        (t Int))
      (block
        (return
          (mcall len
            (field entries
              (name self)))))))
  (type Parser
    (field section
      (t Str)
      (default
        (str "")))
    (field cfg
      (t Config)
      (default
        (call
          (name Config))))
    (fn parse_line fails
      (recv mut)
      (param no
        (t Int))
      (param raw
        (t Str))
      (block
        (let line
          (mcall trim
            (name raw)))
        (if
          (bin or
            (mcall is_empty
              (name line))
            (mcall starts_with
              (name line)
              (named prefix
                (str "#"))))
          (block
            (return)))
        (if
          (bin and
            (mcall starts_with
              (name line)
              (named prefix
                (str "[")))
            (mcall ends_with
              (name line)
              (named suffix
                (str "]"))))
          (block
            (assign
              (field section
                (name self))
              (mcall inner
                (name line)))
            (return)))
        (iflet eq
          (mcall find
            (name line)
            (named text
              (str "=")))
          (block
            (let key
              (mcall trim
                (mcall before
                  (name line)
                  (named sep
                    (name eq)))))
            (if
              (mcall is_empty
                (name key))
              (block
                (fail
                  (name parse)
                  (interp
                    (s "config.ini:")
                    (part
                      (name no))
                    (s ": empty key")))))
            (if
              (mcall is_some
                (mcall get
                  (field cfg
                    (name self))
                  (named section
                    (field section
                      (name self)))
                  (named key
                    (name key))))
              (block
                (fail
                  (name parse)
                  (interp
                    (s "config.ini:")
                    (part
                      (name no))
                    (s ": duplicate key '")
                    (part
                      (name key))
                    (s "' in [")
                    (part
                      (field section
                        (name self)))
                    (s "]")))))
            (mcall push
              (field entries
                (field cfg
                  (name self)))
              (named item
                (call
                  (name Entry)
                  (named section
                    (field section
                      (name self)))
                  (named key
                    (name key))
                  (named value
                    (mcall trim
                      (mcall after
                        (name line)
                        (named sep
                          (name eq)))))))))
          (else
            (block
              (fail
                (name parse)
                (interp
                  (s "config.ini:")
                  (part
                    (name no))
                  (s ": missing '='")))))))))
  (fn parse_fail_fast fails
    (param text
      (t Str))
    (ret
      (t Config))
    (block
      (var p
        (call
          (name Parser)))
      (for
        (ptuple
          (pbind i)
          (pbind l))
        (mcall enumerate
          (mcall lines
            (name text)))
        (block
          (try
            (mcall parse_line
              (name p)
              (named no
                (bin +
                  (name i)
                  (int 1)))
              (named raw
                (name l))))))
      (return
        (field cfg
          (name p)))))
  (fn parse_all
    (param text
      (t Str))
    (param report mut
      (t Report))
    (ret
      (t Config))
    (block
      (var p
        (call
          (name Parser)))
      (for
        (ptuple
          (pbind i)
          (pbind l))
        (mcall enumerate
          (mcall lines
            (name text)))
        (block
          (mcall add_if_err
            (name report)
            (named result
              (mcall parse_line
                (name p)
                (named no
                  (bin +
                    (name i)
                    (int 1)))
                (named raw
                  (name l)))))))
      (return
        (field cfg
          (name p)))))
  (fn parse_int fails
    (param s
      (t Str))
    (ret
