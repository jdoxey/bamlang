          (part
            (name s))))))
  (fn part1 fails
    (block
      (call
        (name print)
        (named text
          (str "== part 1: config parser")))
      (match
        (call
          (name parse_fail_fast)
          (named text
            (name BAD_TEXT)))
        (arm
          (pvariant Ok
            (pwild))
          (block))
        (arm
          (pvariant Err
            (pbind e))
          (call
            (name print)
            (named text
              (interp
                (s "fail-fast: ")
                (part
                  (name e)))))))
      (var report
        (mcall new
          (name Report)))
      (assign
        (name _)
        (call
          (name parse_all)
          (named text
            (name BAD_TEXT))
          (named report
            (name report))))
      (call
        (name print)
        (named text
          (str "collect-all:")))
      (for
        (pbind e)
        (mcall errors
          (name report))
        (block
          (call
            (name print)
            (named text
              (interp
                (s "  ")
                (part
                  (name e)))))))
      (call
        (name print)
        (named text
          (interp
            (part
              (mcall count
                (name report)))
            (s " errors"))))
      (let cfg
        (try
          (call
            (name parse_fail_fast)
            (named text
              (name GOOD_TEXT)))))
      (iflet s
        (mcall get
          (name cfg)
          (named section
            (str "server"))
          (named key
            (str "port")))
        (block
          (let port
            (try-context
              (call
                (name parse_int)
                (named s
                  (name s)))
              (str "server.port")))
          (call
            (name print)
            (named text
              (interp
                (s "server.port = ")
                (part
                  (name port)))))))
      (iflet s
        (mcall get
          (name cfg)
          (named section
            (str "server"))
          (named key
            (str "timeout")))
        (block
          (call
            (name print)
            (named text
              (interp
                (s "server.timeout = ")
                (part
                  (name s))))))
        (else
          (block
            (call
              (name print)
              (named text
                (str "timeout not set, using 30"))))))))
  (fn inject fails
    (param fail_at
      (t Int))
    (param step
      (t Int))
    (block
      (if
        (bin ==
          (name fail_at)
          (name step))
        (block
