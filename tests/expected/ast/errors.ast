                    (name run)))
                (s ": ")
                (part
                  (name res)))))
          (let files
            (try-context
              (mcall join
                (mcall sorted
                  (mcall list
                    (name dir)))
                (named sep
                  (str " ")))
              (str "list dir")))
          (let content
            (try-context
              (call
                (name read)
                (named path
                  (bin /
                    (name dir)
                    (str "data.txt"))))
              (str "read data.txt")))
          (call
            (name print)
            (named text
              (interp
                (s "  files: ")
                (part
                  (name files)))))
          (call
            (name print)
            (named text
              (interp
                (s "  content: ")
                (part
                  (name content)))))))))
