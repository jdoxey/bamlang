# Benchmark 2, build file, C1 baseline (no new syntax). Lists joined with `+`; conditional items are `if c { [x] } else { [] }`.
use extras.build

const PLATFORMS = ["linux-x64", "macos-arm64", "windows-x64"]
const VERSION = "1.4.0"

pub fn build(b: Build) -> Project {
  let windows = b.os == Os.Windows
  let defaults = Defaults(std: "c11", warnings: true, opt: if b.release { Opt.Speed } else { Opt.None })
  let platforms = PLATFORMS.map(each: fn(p) =>
    Package(name: "acme-{p}", platform: p.copy(), deps: ["cli"], archive: if p.starts_with(prefix: "windows") { Archive.Zip } else { Archive.TarGz }))
  return Project(name: "acme", version: VERSION.copy(), defaults, targets: [
    Lib(
      name: "core",
      srcs: b.glob(pattern: "src/core/*.c"),
      defines: ["VERSION={VERSION}"] + (if windows { ["WIN32_LEAN_AND_MEAN"] } else { [] }),
      links: if windows { ["ws2_32"] } else { ["pthread"] },
    ),
    Exe(name: "cli", srcs: ["src/cli/main.c"], deps: ["core"]),
    Exe(name: "core_tests", srcs: b.glob(pattern: "tests/*.c"), deps: ["core"], test: true),
  ] + platforms)
}
