# Benchmark 2, build file, D3. Three targets, shared defaults, an OS conditional, a loop over platforms.
const PLATFORMS = ["linux-x64", "macos-arm64", "windows-x64"]
const VERSION = "1.4.0"

pub fn build(b: Build) -> Project {
  let windows = b.os == Os.Windows
  let defaults = Defaults(std: "c11", warnings: true, opt: if b.release { Opt.Speed } else { Opt.None })
  let core = Lib(name: "core")
    .srcs(files: b.glob(pattern: "src/core/*.c"))
    .define(flag: "VERSION={VERSION}")
    .define_if(cond: windows, flag: "WIN32_LEAN_AND_MEAN")
    .link_if(cond: windows, lib: "ws2_32")
    .link_if(cond: not windows, lib: "pthread")
  return Project(name: "acme")
    .version(text: VERSION)
    .defaults(defaults)
    .target(node: core)
    .target(node: Exe(name: "cli").srcs(files: ["src/cli/main.c"]).dep(name: "core"))
    .target(node: Exe(name: "core_tests").srcs(files: b.glob(pattern: "tests/*.c")).dep(name: "core").test())
    .targets_of(items: PLATFORMS, build: fn(p) => Package(name: "acme-{p}")
      .platform(name: p)
      .dep(name: "cli")
      .archive(kind: if p.starts_with(prefix: "windows") { Zip } else { TarGz }))
}
