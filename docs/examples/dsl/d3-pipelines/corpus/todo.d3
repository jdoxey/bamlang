# Benchmark 1, todo UI, D3 (builder pipelines: leading-dot chains, no grammar change). Nodes are values; setters take
# self and return it; `child_if` and `children_of` carry the control flow.
type Todo {
  id: Int
  title: Str
  done: Bool
}

enum Filter { All, Active, Done }

enum Msg {
  Add(title: Str)
  Toggle(id: Int)
  Delete(id: Int)
  SetFilter(filter: Filter)
  ClearDone
}

type Model {
  items: List of Todo = []
  filter: Filter = Filter.All
  next_id: Int = 1
}

fn label_of(f: Filter) -> Str {
  return match f {
    All => "All",
    Active => "Active",
    Done => "Done",
  }
}

fn visible(m: Model) -> List of Todo {
  return match m.filter {
    All => m.items,
    Active => m.items.filter(keep: fn(t) => not t.done),
    Done => m.items.filter(keep: fn(t) => t.done),
  }
}

type Node {
  tag: Str
  gap: Int = 0
  key: Str = ""
  kids: List of Node = []

  fn gap(take self, size: Int) -> Node { self.gap = size; return self }
  fn child(take self, node: Node) -> Node { self.kids.push(item: node); return self }
  fn child_if(take self, cond: Bool, node: Node) -> Node {
    if cond { self.kids.push(item: node) }
    return self
  }
  fn children_of(take self, items: List of T, build: fn(item: T) -> Node) -> Node {
    for item in items { self.kids.push(item: build(item)) }
    return self
  }
}

fn view(m: Model, ui: Ui) -> Node {
  let draft = ui.slot(name: "draft", initial: "")
  let shown = visible(m)
  let tabs = Row()
    .gap(size: 2)
    .children_of(items: [Filter.All, Filter.Active, Filter.Done], build: fn(f) => Button(label: label_of(f))
      .key(name: "tab-{f}")
      .active(state: m.filter == f)
      .on_click(msg: Msg.SetFilter(filter: f)))
  return Column()
    .gap(size: 8)
    .child(node: Text(content: "Todos").style(kind: Style.Title))
    .child(node: Row()
      .gap(size: 4)
      .child(node: Input().key(name: "draft").slot(slot: draft).placeholder(text: "What needs doing?").on_enter(msg: Msg.Add(title: draft.get())))
      .child(node: Button(label: "Add").on_click(msg: Msg.Add(title: draft.get()))))
    .child(node: tabs)
    .child_if(cond: shown.is_empty(), node: Text(content: "Nothing to do").style(kind: Style.Dim))
    .children_of(items: shown, build: fn(t) => Row()
      .key(name: "todo-{t.id}")
      .gap(size: 4)
      .child(node: Checkbox().checked(state: t.done).on_toggle(msg: Msg.Toggle(id: t.id)))
      .child(node: Text(content: t.title).style(kind: if t.done { Style.Struck } else { Style.Normal }))
      .child(node: Button(label: "x").on_click(msg: Msg.Delete(id: t.id))))
    .child_if(cond: m.items.any(test: fn(t) => t.done), node: Button(label: "Clear completed").on_click(msg: Msg.ClearDone))
}

fn update(mut m: Model, msg: Msg) {
  match msg {
    Add(title) => {
      if title != "" {
        m.items.push(item: Todo(id: m.next_id, title, done: false))
        m.next_id += 1
      }
    },
    Toggle(id) => {
      for t in m.items.iter_mut() {
        if t.id == id { t.done = not t.done }
      }
    },
    Delete(id) => { m.items.retain(keep: fn(t) => t.id != id) },
    SetFilter(f) => { m.filter = f },
    ClearDone => { m.items.retain(keep: fn(t) => not t.done) },
  }
}
