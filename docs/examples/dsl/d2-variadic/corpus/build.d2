# Benchmark 2, build file, D2. Three targets, shared defaults, an OS conditional, a loop over platforms.
const PLATFORMS = ["linux-x64", "macos-arm64", "windows-x64"]
const VERSION = "1.4.0"

pub fn build(b: Build) -> Project {
  let windows = b.os == Os.Windows
  let defaults = Defaults(std: "c11", warnings: true, opt: if b.release { Opt.Speed } else { Opt.None })
  return project(name: "acme", version: VERSION, defaults: defaults,
    lib(
      name: "core",
      srcs: b.glob("src/core/*.c"),
      defines: [
        "VERSION={VERSION}",
        if windows => "WIN32_LEAN_AND_MEAN",
      ],
      links: [
        if windows => "ws2_32",
        if not windows => "pthread",
      ],
    ),
    exe(name: "cli", srcs: ["src/cli/main.c"], deps: ["core"]),
    exe(name: "core_tests", srcs: b.glob("tests/*.c"), deps: ["core"], test: true),
    for p in PLATFORMS => package(name: "acme-{p}", platform: p, deps: ["cli"], archive: if p.starts_with("windows") { Zip } else { TarGz }),
  )
}
