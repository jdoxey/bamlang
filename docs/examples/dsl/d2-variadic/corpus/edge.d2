# Edge cases for D2: argument order, (rest ...) placement, variadic declarations in fns and lambdas.
pub fn card(title: Str, gap: Int = 1, kids: Node...) -> Node { return Node.Card(kids) }
fn one(kids: Node...) -> Node { return Node.Box(kids) }
fn none_(a: Int, b: Int) -> Int { return a + b }
fn edge(xs: List of Int, ok: Bool) {
  let a = f(1, x: 2)
  let b = f(x: 1, y: 2)
  let c = f(x: 1, 2, 3)
  let d = f(1, x: 2, 3)
  let e = f(for x in xs => x)
  let g = f(a, for x in xs => x, b)
  let h = f(x: 1, if ok => 2, 3, for y in xs if y > 1 => y)
  let i = xs.sort(.dept desc, .name)
  let j = f(x: 1,
    g(y: 2, h(z)),
  )
  let k = fn(first: Int, rest: Int...) => first
  let l = f(x: 1, if ok { 1 } else { 2 })
  let m = f(if: 1, for: 2)
  let n = xs.fold(0, fn(acc, x) => acc + x)
  let o = [1..3, 4..=5]
}
