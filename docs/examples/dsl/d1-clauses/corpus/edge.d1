# Edge cases for D1: if-expressions and iflet stay legal as list items; clauses nest and bind (if x = opt => …); guards; names `if:`/`for:`.
fn edge(xs: List of Int, opt: Optional of Int, rows: List of List of Int, pairs: List of Pair, a: Bool) {
  let a = [1, if opt == none { 2 } else { 3 }, 4]
  let b = [if x = opt { x } else { 0 }]
  let c = [for x in xs if x > 1 => x * 2, if xs.is_empty() => 0, 9]
  let d = [for row in xs => [for x in xs => x + row]]
  let e = Cfg(if: 1, for: [for x in xs => x])
  let f = [for (i, x) in xs.enumerate() => i + x]
  let h = [if opt != none => for x in xs => x, for r in rows => for c in r => c]
  let i = [if v = opt => v + 1, for p in pairs => if v = p.second => v]
  let j = [if a { 1 } else { 2 } + 3, if a { 1 } else { 2 }.abs(), -4]
  let g = [
    if a == 1 => "one"
    ,
    for x in xs
      if x != 3
        => x,
  ]
}
