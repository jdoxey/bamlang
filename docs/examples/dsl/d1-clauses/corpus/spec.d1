# Benchmark 3, a test suite (nested groups, shared setup) and an HTML page, D1.
fn spec() -> Spec {
  return Group(name: "Stack", setup: fn() => Stack.new(), kids: [
    Group(name: "empty", kids: [
      Case(name: "is empty", body: fn(s) => expect(ok: s.is_empty())),
      Case(name: "pop gives none", body: fn(s) => expect_eq(actual: s.pop(), expected: none)),
      Case(name: "peek gives none", body: fn(s) => expect_eq(actual: s.peek(), expected: none)),
    ]),
    Group(name: "with three items", before: fn(s) { s.push(item: 1); s.push(item: 2); s.push(item: 3) }, kids: [
      Case(name: "len is 3", body: fn(s) => expect_eq(actual: s.len(), expected: 3)),
      Case(name: "pop gives the last pushed", body: fn(s) => expect_eq(actual: s.pop(), expected: some(value: 3))),
      Group(name: "after one pop", before: fn(s) { s.pop() }, kids: [
        Case(name: "len is 2", body: fn(s) => expect_eq(actual: s.len(), expected: 2)),
        Case(name: "peek gives 2", body: fn(s) => expect_eq(actual: s.peek(), expected: some(value: 2))),
      ]),
      Case(name: "clear empties", body: fn(s) { s.clear(); expect(ok: s.is_empty()) }),
    ]),
    Group(name: "push many", kids: [
      for n in [1, 10, 1000] => Case(name: "len after {n} pushes", body: fn(s) {
        for i in 0..n { s.push(item: i) }
        expect_eq(actual: s.len(), expected: n)
      }),
    ]),
  ])
}

const LINKS = [Link(label: "Home", url: "/"), Link(label: "Stock", url: "/stock"), Link(label: "About", url: "/about")]

fn page(heading: Str, rows: List of Row) -> Html {
  return Html(kids: [
    Head(kids: [Title(text: heading)]),
    Body(kids: [
      Nav(kids: [
        for l in LINKS => A(label: l.label, href: l.url),
      ]),
      H1(text: heading),
      Table(kids: [
        Tr(kids: [for h in ["Name", "Qty", "Price"] => Th(text: h)]),
        if rows.is_empty() => Tr(kids: [Td(text: "no rows", colspan: 3)]),
        for r in rows => Tr(kids: [
          Td(text: r.name),
          Td(text: "{r.qty}", align: Align.Right),
          Td(text: "{r.price:.2}", align: Align.Right),
        ]),
      ]),
    ]),
  ])
}
