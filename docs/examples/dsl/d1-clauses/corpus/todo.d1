# Benchmark 1, todo UI, D1 (clause items in lists). Library types: Column, Row, Text, Input, Button, Checkbox.
type Todo {
  id: Int
  title: Str
  done: Bool
}

enum Filter { All, Active, Done }

enum Msg {
  Add(title: Str)
  Toggle(id: Int)
  Delete(id: Int)
  SetFilter(filter: Filter)
  ClearDone
}

type Model {
  items: List of Todo = []
  filter: Filter = Filter.All
  next_id: Int = 1
}

fn label_of(f: Filter) -> Str {
  return match f {
    All => "All",
    Active => "Active",
    Done => "Done",
  }
}

fn visible(m: Model) -> List of Todo {
  return match m.filter {
    All => m.items,
    Active => m.items.filter(keep: fn(t) => not t.done),
    Done => m.items.filter(keep: fn(t) => t.done),
  }
}

fn view(m: Model, ui: Ui) -> Node {
  let draft = ui.slot(name: "draft", initial: "")
  let shown = visible(m)
  return Column(gap: 8, kids: [
    Text(content: "Todos", style: Style.Title),
    Row(gap: 4, kids: [
      Input(key: "draft", slot: draft, placeholder: "What needs doing?", on_enter: Msg.Add(title: draft.get())),
      Button(label: "Add", on_click: Msg.Add(title: draft.get())),
    ]),
    Row(gap: 2, kids: [
      for f in [Filter.All, Filter.Active, Filter.Done] =>
        Button(label: label_of(f), key: "tab-{f}", active: m.filter == f, on_click: Msg.SetFilter(filter: f)),
    ]),
    if shown.is_empty() => Text(content: "Nothing to do", style: Style.Dim),
    for t in shown => Row(key: "todo-{t.id}", gap: 4, kids: [
      Checkbox(checked: t.done, on_toggle: Msg.Toggle(id: t.id)),
      Text(content: t.title, style: if t.done { Style.Struck } else { Style.Normal }),
      Button(label: "x", on_click: Msg.Delete(id: t.id)),
    ]),
    if m.items.any(test: fn(t) => t.done) => Button(label: "Clear completed", on_click: Msg.ClearDone),
  ])
}

fn update(mut m: Model, msg: Msg) {
  match msg {
    Add(title) => {
      if title != "" {
        m.items.push(item: Todo(id: m.next_id, title, done: false))
        m.next_id += 1
      }
    },
    Toggle(id) => {
      for t in m.items.iter_mut() {
        if t.id == id { t.done = not t.done }
      }
    },
    Delete(id) => { m.items.retain(keep: fn(t) => t.id != id) },
    SetFilter(f) => { m.filter = f },
    ClearDone => { m.items.retain(keep: fn(t) => not t.done) },
  }
}
