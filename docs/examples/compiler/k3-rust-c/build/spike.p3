# D8 spike program. Every compiler spike compiles exactly this file.

type Point {
  x: Int,
  y: Int,
}

type Guard {
  name: Str,
  drop(mut self) {
    print(text: "drop {self.name}")
  }
}

fn area(p: Point, scale: Int) -> Int {
  var total = 0
  var i = 0
  while i < scale {
    total += p.x * p.y
    i += 1
  }
  return total
}

fn depth(n: Int) -> Int {
  let g = Guard(name: "level {n}")
  if n == 0 {
    trap(text: "bottom reached")
  }
  return depth(n: n - 1) + 1
}

fn main() {
  let p = Point(x: 3, y: 4)
  let a = area(p, scale: 2)
  print(text: "area {a}")
  if a > 20 {
    print(text: "big")
  } else {
    print(text: "small")
  }
  expect_trap(action: fn() {
    let outer = Guard(name: "outer")
    depth(n: 2)
  })
  print(text: "after trap")
}
