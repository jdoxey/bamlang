# errors in P1 syntax, from errors/merged/errors.txt (E1 spelling over E2 values).
# fail KIND, MESSAGE builds the Err of the enclosing `fails` function; try has three forms.

const BAD_TEXT = "[server]\n" +
  "port = 8080\n" +
  "port = 9090\n" +
  "=orphan\n" +
  "name\n"
const GOOD_TEXT = "# demo\n[server]\nport = 8080\n"
const TEXTS = ["a=1\nb=2\n", "a=1\noops\n", "a=1\n", "a=1\nb=2\nc=3\n"]

type Entry do
  section: Str
  key: Str
  value: Str
end

type Config do
  entries: List of Entry = []

  fn get(self, section: Str, key: Str) -> Optional of Str do
    # absence is a value, not an error
    for e in self.entries do
      if e.section == section and e.key == key do
        return some(e.value)
      end
    end
    return none
  end

  fn len(self) -> Int do
    return self.entries.len()
  end
end

type Parser do
  section: Str = ""
  cfg: Config = Config()

  fn parse_line(mut self, no: Int, raw: Str) fails do
    let line = raw.trim()
    if line.is_empty() or line.starts_with("#") do
      return
    end
    if line.starts_with("[") and line.ends_with("]") do
      self.section = line.inner()
      return
    end
    if eq = line.find("=") do
      let key = line.before(eq).trim()
      if key.is_empty() do
        fail parse, "config.ini:{no}: empty key"
      end
      if self.cfg.get(self.section, key).is_some() do
        fail parse, "config.ini:{no}: duplicate key '{key}' in [{self.section}]"
      end
      self.cfg.entries.push(Entry(section: self.section, key: key, value: line.after(eq).trim()))
    else do
      fail parse, "config.ini:{no}: missing '='"
    end
  end
end

fn parse_fail_fast(text: Str) -> Config fails do
  var p = Parser()
  for (i, l) in text.lines().enumerate() do
    try p.parse_line(i + 1, l)                      # statement-level try
  end
  return p.cfg
end

fn parse_all(text: Str, mut report: Report) -> Config do
  # cannot fail: collects instead
  var p = Parser()
  for (i, l) in text.lines().enumerate() do
    report.add_if_err(p.parse_line(i + 1, l))       # consumes the Result
  end
  return p.cfg
end

fn parse_int(s: Str) -> Int fails do
  if n = s.to_int() do
    return n
  end
  fail parse, "not an integer: {s}"
end

fn part1() fails do
  print("== part 1: config parser")
  match parse_fail_fast(BAD_TEXT) do
    Ok(_)  => do
    end
    Err(e) => print("fail-fast: {e}")
  end
  var report = Report.new()
  _ = parse_all(BAD_TEXT, report)
  print("collect-all:")
  for e in report.errors() do
    print("  {e}")
  end
  print("{report.count()} errors")

  let cfg = try parse_fail_fast(GOOD_TEXT)
  if s = cfg.get("server", "port") do
    let port = try parse_int(s) context "server.port"
    print("server.port = {port}")
  end
  if s = cfg.get("server", "timeout") do
    print("server.timeout = {s}")
  else do
    print("timeout not set, using 30")
  end
end

fn inject(fail_at: Int, step: Int) fails do
  if fail_at == step do
    fail test, "injected failure"
  end
end

fn replace_file(dir: Path, name: Str, content: Str, fail_at: Int) fails do
  let lock_path = "{dir}/{name}.lock"; let tmp = "{dir}/{name}.tmp"; let dst = "{dir}/{name}"
  let txn = Txn.new(fn() do
    remove(tmp)
  end)          # undo unless commit; cannot fail
  let held = try Lock.create(lock_path) context "step 1: create lock"
  txn.on_undo(fn() => held.abandon())
  try inject(fail_at, 1) context "step 1: create lock"

  let f = try File.create(tmp) context "step 2: write temp"
  try f.write(content) context "step 2: write temp"
  try f.close() context "step 2: write temp"      # explicit fallible cleanup
  try inject(fail_at, 2) context "step 2: write temp"

  try inject(fail_at, 3) context "step 3: rename temp"
  try rename(tmp, dst) context "step 3: rename temp"

  try inject(fail_at, 4) context "step 4: remove lock"
  try held.close() context "step 4: remove lock"   # consuming close
  txn.commit()                                       # success: undo does not run
end

fn part2() fails do
  print("== part 2: replace_file")
  let dir = try TempDir.create("errors") context "make temp dir"
  try write(dir / "data.txt", "old") context "seed data.txt"
  let labels = ["no failure", "fail at step 1", "fail at step 2", "fail at step 3", "fail at step 4"]
  for run in 0..5 do
    let res = match replace_file(dir, "data.txt", "v{run + 1}", run) do
      Ok(_)  => "ok"
      Err(e) => "error: {e}"
    end
    print("run {run + 1}, {labels[run]}: {res}")
    let files = try dir.list().sorted().join(" ") context "list dir"
    let content = try read(dir / "data.txt") context "read data.txt"
    print("  files: {files}")
    print("  content: {content}")
  end
end

fn worker(n: Int, text: Str) -> Int fails do
  let cfg = try parse_fail_fast(text) context "worker {n}"
  return cfg.len()
end

fn worker3(text: Str, m: Mutex of Int, mut tally: Int) -> Int fails do
  let cfg = try parse_fail_fast(text) context "worker 3"
  lock m do
    # released by unwinding; mutex poisoned
    tally += 10
    let keys = cfg.keys()
    print(keys[keys.len() + 5])                      # a trap: index out of range
  end
  return cfg.len()
end

fn part3() fails do
  print("== part 3: crew")
  let m = Mutex(0)
  var tally = 100
  _ = try crew c do
    # converts a CHILD's trap to Error{kind: trap} at the `end`
    c.go(fn() => worker(1, TEXTS[0]))
    c.go(fn() => worker(2, TEXTS[1]))
    c.go(fn() => worker3(TEXTS[2], m, tally))
    c.go(fn() => worker(4, TEXTS[3]))
  end or e do
    print("error: {e}")                              # error: worker 2: config.ini:2: missing '=' (plus 1 more)
    Unit
  end
  print("mutex poisoned: {if m.is_poisoned() do "yes" else do "no" end}")
  expect_trap(fn() do
    let scratch = Mutex(0)
    var t = 0
    worker3(TEXTS[2], scratch, t)
  end)
  print("expect_trap ok")
end

fn main() fails do
  try part1()
  try part2()
  try part3()
end
