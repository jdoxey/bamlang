# chatsim in P1 syntax, from c/chatsim.c. Pools and handles replace raw pointers; the archive worker is a crew child.
use std.sync
use std.text as text

const RATE_LIMIT = 3

type User {
  pub name: Str
  room: Optional of Handle of Room
  last_from: Optional of Handle of User
  had_contact: Bool = false
  is_bot: Bool = false

  drop(mut self) {
    print("user {self.name} dropped")
  }
}

type Member {
  user: Handle of User
  cb: fn(mut Server, Handle of Room, Handle of User, Str)
}

type Room {
  name: Str
  members: List of Member = []
  history: List of Str = []

  fn remove_member(mut self, u: Handle of User) {
    var i = 0
    while i < self.members.len() {
      if self.members[i].user == u {
        self.members.remove_at(i)
        break
      }
      i += 1
    }
  }
}

type Timer { due: Int, user: Optional of Handle of User, user_name: Str, text: Str }
type RateEntry { tick: Int, count: Int }
type Job { room_name: Str, history: List of Str }

type Stats {
  messages: Int = 0
  archived_rooms: Int = 0
  archived_messages: Int = 0
  archive: List of Str = []
}

type Server {
  users: Pool of User = Pool of User()
  rooms: Pool of Room = Pool of Room()
  timers: List of Timer = []
  rates: Map of Str to RateEntry = Map of Str to RateEntry()
  clock: Int = 0
  jobs: Channel of Job
  stats: Mutex of Stats

  fn find_user(self, name: Str) -> Optional of Handle of User {
    for h in self.users.handles() {
      if self.users[h].name == name { return some(h) }
    }
    return none
  }

  fn find_room(self, name: Str) -> Optional of Handle of Room {
    for h in self.rooms.handles() {
      if self.rooms[h].name == name { return some(h) }
    }
    return none
  }

  fn rate_ok(mut self, name: Str) -> Bool {
    if not self.rates.contains(name) {
      self.rates[name] = RateEntry(tick: self.clock, count: 0)
    }
    with e = self.rates[name] {
      if e.tick != self.clock {
        e.tick = self.clock
        e.count = 0
      }
      if e.count >= RATE_LIMIT {
        print("rate limited: {name}")
        return false
      }
      e.count += 1
    }
    return true
  }

  fn bump(self, n: Int) {
    lock self.stats {
      self.stats.messages += n
    }
  }

  fn post(mut self, room: Handle of Room, from: Handle of User, text: Str) {
    let who = self.users[from].name
    self.rooms[room].history.push("{who}: {text}")
    self.bump(1)
    print("#{self.rooms[room].name} {who}: {text}")
    var i = 0
    while i < self.rooms[room].members.len() {   # index, not iterator: a callback may post again
      let m = self.rooms[room].members[i]
      if m.user != from { m.cb(self, room, from, text) }
      i += 1
    }
  }

  fn open_room(mut self, name: Str) -> Handle of Room {
    print("#{name} opened")
    return self.rooms.add(Room(name: name.copy()))
  }

  fn enter_room(mut self, u: Handle of User, room_name: Str) {
    let r = if found = self.find_room(room_name) { found } else { self.open_room(room_name) }
    let cb = if self.users[u].is_bot {
      fn(srv, room, from, text) {
        print("  {srv.users[u].name} sees {srv.users[from].name}: {text}")
        if not srv.users[from].is_bot {
          srv.post(room, u, "echo: {text}")
        }
      }
    } else {
      fn(srv, room, from, text) {
        print("  {srv.users[u].name} sees {srv.users[from].name}: {text}")
      }
    }
    self.rooms[r].members.push(Member(user: u, cb: cb))
    self.users[u].room = some(r)
    print("{self.users[u].name} joined #{self.rooms[r].name}")
  }

  fn exit_room(mut self, u: Handle of User) {
    if r = self.users[u].room {
      self.rooms[r].remove_member(u)
      self.users[u].room = none
      print("{self.users[u].name} left #{self.rooms[r].name}")
      if self.rooms[r].members.is_empty() {
        let room = self.rooms.take_out(r).unwrap()
        print("#{room.name} closed, {room.history.len()} messages sent to archive")
        self.jobs.send(Job(room_name: room.name, history: room.history))   # history moves to the worker
      }
    }
  }

  fn free_user(mut self, u: Handle of User) {
    for h in self.users.handles() {
      if self.users[h].last_from == some(u) { self.users[h].last_from = none }
    }
    for i in 0..self.timers.len() {
      if self.timers[i].user == some(u) { self.timers[i].user = none }
    }
    self.rates.remove(self.users[u].name)
    self.users.remove(u)
  }

  fn cmd_join(mut self, name: Str, room: Str) {
    if self.find_user(name) != none {
      print("join failed: {name} is already here")
      return
    }
    let u = self.users.add(User(name: name.copy(), room: none, last_from: none, is_bot: name == "echobot"))
    self.enter_room(u, room)
  }

  fn cmd_say(mut self, name: Str, text: Str) {
    if u = self.find_user(name) {
      if not self.rate_ok(name) { return }
      if r = self.users[u].room { self.post(r, u, text) }
    } else {
      print("say failed: {name} is not here")
    }
  }

  fn deliver_dm(mut self, from: Handle of User, dest: Handle of User, text: Str) {
    let fname = self.users[from].name
    let dname = self.users[dest].name
    print("dm {fname} -> {dname}: {text}")
    print("  {dname} sees dm from {fname}: {text}")
    self.users[dest].last_from = some(from)
    self.users[dest].had_contact = true
    self.bump(1)
  }

  fn cmd_dm(mut self, from_name: Str, to_name: Str, text: Str) {
    match (self.find_user(from_name), self.find_user(to_name)) {
      (none, _) => print("dm failed: {from_name} is not here")
      (_, none) => print("dm failed: {to_name} is not here")
      (some(f), some(d)) => {
        if self.rate_ok(from_name) { self.deliver_dm(f, d, text) }
      }
    }
  }

  fn cmd_remind(mut self, name: Str, delay: Int, text: Str) {
    if u = self.find_user(name) {
      let due = self.clock + delay
      var i = 0
      while i < self.timers.len() and self.timers[i].due <= due { i += 1 }
      self.timers.insert(i, Timer(due: due, user: some(u), user_name: name.copy(), text: text.copy()))
      print("reminder for {name} set for tick {due}")
    } else {
      print("remind failed: {name} is not here")
    }
  }

  fn cmd_tick(mut self, n: Int) {
    for _ in 0..n {
      self.clock += 1
      while (self.timers.len() > 0
          and self.timers[0].due <= self.clock) {
        let t = self.timers.remove_at(0)
        match t.user {
          some(h) => print("reminder for {self.users[h].name}: {t.text}")
          none => print("reminder for {t.user_name} dropped: user has left")
        }
      }
    }
    print("clock is {self.clock}")
  }

  fn cmd_move(mut self, name: Str, room: Str) {
    if u = self.find_user(name) {
      self.exit_room(u)
      self.enter_room(u, room)
    } else {
      print("move failed: {name} is not here")
    }
  }

  fn cmd_leave(mut self, name: Str) {
    if u = self.find_user(name) {
      self.exit_room(u)
      self.free_user(u)
    } else {
      print("leave failed: {name} is not here")
    }
  }

  fn cmd_stats(self) {
    self.jobs.flush()
    lock self.stats {
      print(
        "stats: users={self.users.len()} rooms={self.rooms.len()}",
        " messages={self.stats.messages}",
        " archived_rooms={self.stats.archived_rooms}",
      )
      for line in self.stats.archive { print("  archive {line}") }
    }
  }

  fn handle(mut self, line: Str) {
    let w = line.split(" ")
    match w[0] {
      "join"   => self.cmd_join(w[1], w[2])
      "say"    => self.cmd_say(w[1], w.rest(2).join(" "))
      "dm"     => self.cmd_dm(w[1], w[2], w.rest(3).join(" "))
      "remind" => self.cmd_remind(w[1], w[2].to_int().unwrap(), w.rest(3).join(" "))
      "tick"   => self.cmd_tick(w[1].to_int().unwrap())
      "move"   => self.cmd_move(w[1], w[2])
      "leave"  => self.cmd_leave(w[1])
      "stats"  => self.cmd_stats()
      _        => print("bad command: {w[0]}")
    }
  }
}

fn archive_worker(jobs: Channel of Job, stats: Mutex of Stats) {
  while true {
    if job = jobs.recv() {
      sleep_ms(20)
      var bytes = 0
      for line in job.history { bytes += line.len() }
      let n = job.history.len()
      let entry = "{job.room_name}: {n} messages, {bytes} bytes"
      lock stats {
        stats.archived_rooms += 1
        stats.archived_messages += n
        stats.archive.push(entry)
      }
    } else {
      break
    }
  }
}

fn main() fails {
  let jobs = Channel of Job()
  let stats = Mutex(Stats())
  var srv = Server(jobs: jobs, stats: stats)
  try crew c {
    c.go(fn() => archive_worker(jobs, stats))
    for line in stdin.lines() {
      if line.is_empty() or line.starts_with("#") { continue }
      print("> {line}")
      srv.handle(line)
    }
    jobs.close()
  } else e {
    print("fatal: {e}")
  }
  print("exit: alive users={srv.users.len()} rooms={srv.rooms.len()}")
}
