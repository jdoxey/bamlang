# types in P1 syntax, from types/t3plus/types.txt. Methods live inside the type; conformance is `impl I for T`.

module core {
  # B1. Shape: a set OTHERS extend -> iface + dyn
  iface Shape is show {
    fn area(self) -> Float
    fn name(self) -> Str
    fn describe(self) -> Str {                       # provided: has a body, never overridden
      return "{self.name()} {self.area():.2}"
    }
    fn intersects(self, other: dyn Shape) -> Bool {  # a dyn parameter borrows, no allocation
      return self.area().sqrt() + other.area().sqrt() > 5.0
    }
  }

  type Circle {
    r: Float

    pub fn new(r: Float) -> Circle fails {
      if r <= 0.0 { fail "bad radius {r}" }
      return Circle(r: r)
    }
    fn area(self) -> Float { return PI * self.r * self.r }
    fn name(self) -> Str { return "circle" }
  }

  type Rect {
    w: Float
    h: Float

    pub fn new(w: Float, h: Float) -> Rect fails {
      if w <= 0.0 or h <= 0.0 { fail "bad size {w}x{h}" }
      return Rect(w: w, h: h)
    }
    fn area(self) -> Float { return self.w * self.h }
    fn name(self) -> Str { return "rect" }
  }

  impl Shape for Circle
  impl Shape for Rect

  # B2. Widget: closed core kinds + open plugin kinds -> enum with ONE Ext(dyn) variant
  pub enum Event { Click, Drag(Int), Close }
  const FOCUS = "focus moves to next"

  iface WidgetKind {
    fn render(self, depth: Int) -> Str
    fn event(mut self, path: List of Int, ev: Event) -> Str
    fn close(take self) -> Str
    fn focus_next(self) -> Str { return FOCUS }
  }

  # shared routing, public so a plugin container reuses it: Close at the last step takes the child out
  pub fn route(mut children: List of Widget, path: List of Int, ev: Event) -> Str {
    match (path, ev) {
      ([], _) => return "ignored"
      ([i], Close) if i < children.len() => {
        let c = children.take_out(i)
        return "consumed {c.close()}; {FOCUS}"
      }
      ([i, ..rest], _) => return match children.get_mut(i) { some(c) => c.event(rest, ev), none => "no such widget" }
      _ => return "ignored"
    }
  }

  pub enum Widget {
    Panel(children: List of Widget)
    Button(label: Str)
    Ext(dyn WidgetKind)

    pub fn panel(children: List of Widget) -> Widget { return Panel(children) }
    pub fn button(label: Str) -> Widget fails {
      if label == "" { fail "empty label" }
      return Button(label)
    }

    fn render(self, depth: Int) -> Str {
      match self {
        Panel(children) => {
          var out = "{indent(depth)}Panel\n"
          for c in children { out += c.render(depth + 1) }
          return out
        }
        Button(label) => return "{indent(depth)}Button {label}\n"
        Ext(d)        => return d.render(depth)
      }
    }

    fn event(mut self, path: List of Int, ev: Event) -> Str {
      match self {
        Panel(children) => return route(children, path, ev)
        Button(label)   => match ev { Click => return "pressed {label}; {FOCUS}", _ => return "ignored" }
        Ext(d)          => return d.event(path, ev)
      }
    }

    fn collapse(mut self) {
      match self {
        Panel(children) => { let n = children.len(); self = Button("panel of {n}") }
        _ => {}
      }
    }

    fn close(take self) -> Str {
      match self {
        Panel(children) => return "Panel[{children.map(fn(c) { c.close() }).join(", ")}]"
        Button(label)   => return "Button {label}"
        Ext(d)          => return d.close()
      }
    }
  }

  # B3. Money: private field + fails constructor
  type Money {
    cents: Int

    pub fn new(cents: Int) -> Money fails {
      if cents < 0 { fail "negative money {cents}" }
      return Money(cents: cents)
    }
    pub fn cents(self) -> Int { return self.cents }
    pub fn plus(self, o: Money) -> Money { return Money(cents: self.cents + o.cents) }
    pub fn minus(self, o: Money) -> Optional of Money {
      if o.cents > self.cents { return none }
      return some(Money(cents: self.cents - o.cents))
    }
  }

  type Account {
    owner: Str
    balance: Money

    pub fn new(owner: Str, balance: Money) -> Account fails {
      if owner == "" { fail "empty owner" }
      return Account(owner: owner, balance: balance)
    }
    pub fn deposit(mut self, m: Money) { self.balance = self.balance.plus(m) }
    pub fn withdraw(mut self, m: Money) fails {
      match self.balance.minus(m) {
        some(b) => { self.balance = b }
        none    => fail "insufficient funds: balance {self.balance.cents()}, need {m.cents()}"
      }
    }
  }

  pub fn transfer(mut pool: Pool of Account, a: Handle of Account, b: Handle of Account, m: Money) fails {
    with src = pool[a] { try src.withdraw(m) }
    with dst = pool[b] { dst.deposit(m) }
  }
}

module plugin {
  use core.Shape
  use core.WidgetKind
  use core.Widget

  type Hexagon {
    side: Float

    pub fn new(side: Float) -> Hexagon fails {
      if side <= 0.0 { fail "bad side {side}" }
      return Hexagon(side: side)
    }
    fn area(self) -> Float { return 3.0 * 3.0.sqrt() / 2.0 * self.side * self.side }
    fn name(self) -> Str { return "hexagon" }
    fn grow(mut self, k: Float) { self.side = self.side * k }   # fields are only self.side, never bare `side`
  }
  impl Shape for Hexagon

  type SliderSpec { pub value: Int, pub max: Int = 10 }       # DSL-style: every field pub, defaults allowed

  type Slider {
    value: Int
    max: Int

    pub fn new(s: SliderSpec) -> Slider fails {
      if s.value < 0 or s.value > s.max { fail "slider out of range" }
      return Slider(value: s.value, max: s.max)
    }
    fn render(self, depth: Int) -> Str { return "{indent(depth)}Slider {self.value}/{self.max}\n" }
    fn event(mut self, path: List of Int, ev: Event) -> Str {
      match ev {
        Drag(d) => {
          let old = self.value
          self.value = clamp(old + d, 0, self.max)
          return "value {old} -> {self.value}; {self.focus_next()}"
        }
        _ => return "ignored"
      }
    }
    fn close(take self) -> Str { return "Slider {self.value}/{self.max}" }
  }
  impl WidgetKind for Slider

  # a plugin container: holds core Widgets, reuses core's route
  type Tabs {
    children: List of Widget

    pub fn new(children: List of Widget) -> Tabs fails {
      if children.is_empty() { fail "empty tabs" }
      return Tabs(children: children)
    }
    fn render(self, depth: Int) -> Str {
      var out = "{indent(depth)}Tabs\n"
      for c in self.children { out += c.render(depth + 1) }
      return out
    }
    fn event(mut self, path: List of Int, ev: Event) -> Str { return route(self.children, path, ev) }
    fn close(take self) -> Str { return "Tabs[{self.children.map(fn(c) { c.close() }).join(", ")}]" }
  }
  impl WidgetKind for Tabs
}

fn b1() fails {
  let c1 = try Circle.new(1.0)
  let h1 = try Hexagon.new(2.0)
  let r1 = try Rect.new(2.0, 3.0)
  let shapes: List of dyn Shape = [c1, h1, r1]
  var total = 0.0
  for s in shapes { print(s.describe()); total += s.area() }
  print("total {total:.2}")
  eprint("{shapes[0].intersects(shapes[1])} {shapes[1].show()}")
}

fn b2() fails {
  let cancel = try Widget.button("Cancel")
  let ok = try Widget.button("OK")
  let slider = try Slider.new(SliderSpec(value: 3))      # max defaulted
  let inner = Widget.panel([cancel])
  var root = Widget.panel([ok, Widget.Ext(slider), inner])
  print("build"); print(root.render(0))
  let x = try Widget.button("X")
  let tabs = try Tabs.new([x])
  var t = Widget.panel([Widget.Ext(tabs)])
  root.collapse()
}
