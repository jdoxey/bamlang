# tricky: the ten hardest snippets from research.md, plus extras. Meaning is by the P3 rules only (brackets and a leading . continue; nothing else).

# 1. return, newline, value: a bare return, then an unreachable expression statement
fn t1() -> Int {
  let x = 1
  return
  x
}

# 2. a line starting with ( or [ is a new statement, never a call or an index of the line before
fn t2(a: Int) {
  let b = a
  (b)
  [1, 2]
  b
  (a, b)
}

# 3. unary minus at the start of a line is a new statement; a trailing minus is an error outside ( ) (see bad/), so the join is parenthesised; `a -b` is binary
fn t3(a: Int, b: Int) {
  let c = a
  -c
  let d = (a -
    b)
  let e = a -b
  let f = a - -b
}

# 4. leading-dot chains continue across blank lines and comment lines; ?. at line start too
fn t4(items: List of Int) {
  let r = items
    .filter(fn(x) => x > 0)

    # a comment between the links
    .map(fn(x) => x * 2)
    ?.first()
  r
}

# 5. a trailing operator continues only inside ( ); a trailing comma or opener only inside [ ] or ( )
fn t5(a: Int, b: Int) -> Int {
  let s = (a +
    b *
    2)
  let t = [
    1,
    2,
  ]
  return s
}

# 6. a multi-line condition is wrapped in ( ); inside, leading and / or are plain whitespace
fn t6(a: Int, b: Int, c: Int) -> Bool {
  if (a > 0
      and b > 0
      or c > 0) {
    return true
  }
  return (a > 0 and
    b > 0)
}

# 7. the block opens on the header line, also for lambdas; `} else {` shares the line
fn t7(items: List of Int, c: Crew) {
  c.go(fn() {
    for x in items {
      print(x)
    }
  })
  if items.is_empty() {
    print("empty")
  } else if items.len() == 1 {
    print("one")
  } else {
    print("many")
  }
}

# 8. try handlers: `or e {` stays on the line of the try operand (a leading `or` on the next line is an error)
fn t8() fails {
  let a = try f(1) or e {
    return
  }
  let b = try f(2) or _ { }
  try g() context "ctx"
}

# 9. multi-line argument lists with trailing commas; named args; field-list ordering args
fn t9(rows: List of Row) {
  let sorted = rows.sort_by(
    .dept,
    .salary desc,
    .name,
  )
  let w = Widget(
    label: "OK",
    size: 3,
  )
  rows.sort_by(.dept desc, .a.b)
}

# 10. multi-line declarations; a < b > (c) is two comparisons, never a generic
fn t10(
  a: Int,
  b: Int,
  c: Int = 3,
) -> Int {
  let g = a < b > (c)
  return g
}
